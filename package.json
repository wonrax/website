{
  "name": "wonrax-web",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "check": "turbo run check",
    "build": "turbo run build",
    "dev": "wireit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "prisma:push": "npx prisma db push"
  },
  "wireit": {
    "dev": {
      "dependencies": [
        "./web:dev",
        "./api:dev"
      ]
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@prisma/client": "^7.10.1",
    "eslint": "^10.15.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-solid": "^0.20.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "wireit": "^0.15.0"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "prisma": {
    "seed": "ts-node api/prisma/seed.ts"
  }
}
